# 复制为 apps/api/.env 或仓库根目录 .env

# --- API ---
DEMO_MODE=false
# Windows 缺 CA 证书时设为 false；CI/正式环境建议 true
SSL_VERIFY=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# 非空则所有接口（除公开 auth/health）需请求头 X-API-Key
API_KEY=
# 多人部署：设非空 JWT_SECRET 后默认开启登录（每人独立自选/模拟盘）
JWT_SECRET=
JWT_EXPIRE_HOURS=168
# 可选显式开关；留空则「有 JWT_SECRET 即开启」
# AUTH_REQUIRED=true
# 生产建议 false
DOCS_ENABLED=true
SCAN_MAX_CONCURRENT=1
SCAN_USE_ISOLATED=true
SECTOR_UNIVERSE_USE_ISOLATED=false
PREFER_ISOLATED_TIMEOUT=true
SCAN_SNAPSHOT_KEEP=30

# --- 风险过滤（默认剔除涨跌幅规则不同的板块） ---
EXCLUDE_STAR_MARKET=true
EXCLUDE_BSE=true

# --- 行情缓存 ---
# 日线按日缓存：盘前/收盘后/周末缓存到下一交易日开盘前；盘中只有最后一根K会变
DAILY_CACHE_ENABLED=true
DAILY_CACHE_INTRADAY_TTL=1800
# 全市场快照隔离子进程超时（实测抓取约 15s，需留足 pickle/传输余量）
SPOT_ISOLATED_TIMEOUT=60

# --- 早盘分时阈值（避免 9:30 后的短序列被误判为代理分） ---
# MINUTE_MIN_ROWS=15
# MINUTE_MIN_ROWS_EARLY=8
# MINUTE_EARLY_WINDOW_MIN=30

# --- 策略打分参数（完整清单见 apps/api/config.py「策略打分参数」区） ---
# 调整任一参数请同步 STRATEGY_VERSION，便于复盘按版本回溯
STRATEGY_VERSION=2026.09.03-funnel

# 追高惩罚：量能/斜率本质是"正在拉升"的度量，会被重复计入使拉升票虚高。
# 补上"买入位置"维度：日内位置过高 / 正乖离均价过大 -> 降权
# CHASE_PENALTY_ENABLED=true
# CHASE_POS_HIGH=0.90
# CHASE_POS_PENALTY=15
# CHASE_DEV_HIGH=2.5
# CHASE_DEV_PENALTY=12
# 回踩判定带 ±0.8%、末段 6 根、量能 1.3/1.8 档、斜率 0.4/1.0 档等均可覆盖，例：
# FENSHI_PULLBACK_BAND=0.008
# VOL_HOT=1.8
# SLOPE_HOT=1.0

# --- Web (Next.js，写在 apps/web/.env.local) ---
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
# NEXT_PUBLIC_API_KEY=
