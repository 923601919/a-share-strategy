    "/api/watchlist": {
      "get": {
        "summary": "Get Watchlist",
        "description": "默认快速返回库内自选；行情/收益刷新按需开启。超过 T+3 的条目会自动归档并移出。",
        "operationId": "get_watchlist_api_watchlist_get",
        "parameters": [
          {
            "name": "with_quotes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "With Quotes"
            }
          },
          {
            "name": "refresh_returns",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Refresh Returns"
            }
          },
          {
            "name": "with_risk",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "是否拉日线算异动（较慢）",
              "default": false,
              "title": "With Risk"
            },
            "description": "是否拉日线算异动（较慢）"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Watchlist",
        "operationId": "post_watchlist_api_watchlist_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatchIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
