  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReviewIn": {
        "properties": {
          "trade_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Date",
            "description": "交易日 YYYY-MM-DD，默认今天"
          },
          "persist": {
            "type": "boolean",
            "title": "Persist",
            "default": true
          }
        },
        "type": "object",
        "title": "ReviewIn"
      },
      "ScanIn": {
        "properties": {
          "min_amount_yi": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Amount Yi",
            "description": "成交额下限（亿）"
          },
          "min_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Pct"
          },
          "max_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Pct",
            "description": "当前涨幅上限%"
          },
          "session": {
            "type": "string",
            "enum": [
              "auto",
              "morning",
              "afternoon",
              "any"
            ],
            "title": "Session",
            "default": "auto"
          },
          "top_n": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Top N"
          },
          "board_top_n": {
            "type": "integer",
            "title": "Board Top N",
            "default": 15
          },
          "mode": {
            "type": "string",
            "enum": [
              "fenshi",
              "leader_dip"
            ],
            "title": "Mode",
            "default": "fenshi"
          }
        },
        "type": "object",
        "title": "ScanIn"
      },
      "SimResetIn": {
        "properties": {
          "initial_capital": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Capital",
            "description": "重置初始资金，默认10万"
          }
        },
        "type": "object",
        "title": "SimResetIn"
      },
      "SimSellIn": {
        "properties": {
          "position_id": {
            "type": "integer",
            "title": "Position Id"
          },
          "price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Price"
          }
        },
        "type": "object",
        "required": [
          "position_id"
        ],
        "title": "SimSellIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WatchIn": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": ""
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "fenshi",
              "longtou"
            ],
            "title": "Source",
            "default": "manual"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": ""
          },
          "entry_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Price"
          },
          "entry_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Pct"
          },
          "entry_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Entry Score"
          },
          "minute_confirmed": {
            "type": "boolean",
            "title": "Minute Confirmed",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "WatchIn"
      }
    }
  }
